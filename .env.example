# Скопируйте в .env и подставьте значения из Supabase → Project Settings → API
# Префикс EXPO_PUBLIC_ обязателен: без него Expo не прокинет переменную в бандл.
#
# anon-ключ публичный по замыслу — он попадает и в APK, и в JS веб-версии.
# Данные защищает не он, а RLS-политики из
# supabase/migrations/20260818120200_rls.sql.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Кризисная линия — номер, который увидит человек, написавший о желании
# уйти из жизни. Пока пусто, приложение показывает «обратитесь к тому,
# кому доверяете», без номера.
#
# Заполнять ТОЛЬКО проверенным по официальному источнику номером.
# Ошибка здесь хуже пустого поля: человек в кризисе наберёт то, что
# написано на экране, и попадёт не туда.
EXPO_PUBLIC_CRISIS_LINE=

# Имя бота без @ — из него собирается ссылка t.me/<имя>?start=<код>.
EXPO_PUBLIC_TELEGRAM_BOT=UndercurrentBot
