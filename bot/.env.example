# Скопируйте в bot/.env и заполните. Файл в .gitignore — репозиторий публичный.

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AA...

# Куда бот отправляет человека за разговором. Для B2B это единственное,
# что он делает: сама переписка возможна только в приложении, где у неё
# есть анонимность.
APP_URL=https://mandaloriancs.github.io/undercurrent/

# Как часто спрашивать базу о новых уведомлениях, секунды.
# 15 — компромисс: человек воспринимает это как «сразу», а нагрузка
# остаётся четыре запроса в минуту.
POLL_SECONDS=15
