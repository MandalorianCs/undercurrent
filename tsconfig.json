{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    // Node исполняет TypeScript, срезая типы, но модули ищет как есть —
    // без расширения .ts он импорт не найдёт. Компилятору такой импорт
    // по умолчанию не нравится, поэтому разрешаем явно.
    //
    // Безопасно только потому, что мы ничего не компилируем: сборкой
    // занимается Metro, а tsc здесь работает исключительно проверкой.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    // Edge Functions исполняет Deno: там свои глобальные объекты (Deno.env,
    // Deno.serve) и импорты по URL и jsr:. Компилятор приложения их не
    // знает и сыплет ошибками на исправном коде.
    //
    // Проверять их всё же нужно — этим занимается `npm run check:functions`
    // через Supabase CLI, который поднимает настоящий Deno.
    "supabase/functions"
  ]
}
